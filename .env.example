# Google Gemini API Key (Required for LLM generation)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Supabase Configuration (Required for Auth & Conversation Persistence)
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase Service Role Key (for administrative backend operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Web Search Provider (Optional but recommended for the agentic web_search tool)
# Provide either Tavily (recommended - https://tavily.com free tier) or Serper (https://serper.dev)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here
